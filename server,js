// Daler quiz serveri (Admin panel va xavfsiz reyting bilan)
const http = require('http'), fs = require('fs'), path = require('path');
const PORT = process.env.PORT || 3000, ADMIN_KEY = process.env.ADMIN_KEY || 'admin123';
const DIR = process.env.DATA_DIR || path.join(__dirname, 'data'), FILE = path.join(DIR, 'results.json');
const T_PTS = 5, W_PTS = 5, NQ = 15, NW = 8, BASE = NQ * T_PTS + NW * W_PTS, MAXT = 1200;

fs.mkdirSync(DIR, { recursive: true });
let rows = [];
try { rows = JSON.parse(fs.readFileSync(FILE, 'utf8')); } catch (e) {}

const save = () => fs.writeFileSync(FILE, JSON.stringify(rows));
const send = (res, code, obj) => {
    res.writeHead(code, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
    res.end(JSON.stringify(obj));
};

http.createServer((req, res) => {
    const urlObj = new URL(req.url, `http://${req.headers.host}`);
    const pathname = urlObj.pathname;

    // --- ADMIN PANEL SAHIFASI (/admin) ---
    if (pathname === '/admin') {
        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
        res.end(`
        <!DOCTYPE html>
        <html lang="uz">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Admin Panel - Daler Quiz</title>
            <style>
                body { font-family: sans-serif; background: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
                .card { background: #1e293b; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); width: 100%; max-width: 450px; text-align: center; }
                input { width: 100%; padding: 0.75rem; margin: 1rem 0; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: white; box-sizing: border-box; }
                button { width: 100%; padding: 0.75rem; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; transition: 0.2s; }
                .btn-danger { background: #ef4444; color: white; margin-top: 1rem; }
                .btn-danger:hover { background: #dc2626; }
                .btn-primary { background: #3b82f6; color: white; }
                ul { text-align: left; padding-left: 1.2rem; max-height: 250px; overflow-y: auto; background: #0f172a; padding: 10px; border-radius: 6px; }
                li { margin-bottom: 8px; font-size: 14px; }
            </style>
        </head>
        <body>
            <div class="card">
                <h2>🔒 Admin Panel</h2>
                <div id="login-form">
                    <input type="password" id="key" placeholder="Admin parolni kiriting (admin123)">
                    <button class="btn-primary" onclick="loadAdmin()">Kirish</button>
                </div>
                
                <div id="admin-content" style="display:none;">
                    <h3>Natijalar reytingi</h3>
                    <ul id="list"></ul>
                    <button class="btn-danger" onclick="resetData()">🗑 Barcha reytingni tozalash</button>
                </div>
            </div>

            <script>
                async function loadAdmin() {
                    const key = document.getElementById('key').value;
                    const res = await fetch('/api/results', { headers: { 'x-admin-key': key } });
                    if (res.status === 403) {
                        alert('Parol noto\\'g\\'ri!');
                        return;
                    }
                    const data = await res.json();
                    document.getElementById('login-form').style.display = 'none';
                    document.getElementById('admin-content').style.display = 'block';
                    
                    const list = document.getElementById('list');
                    list.innerHTML = data.length ? '' : '<li>Reyting hozircha bo\\'sh</li>';
                    data.forEach(item => {
                        list.innerHTML += \`<li><b>\${item.name}</b> — \${item.total || 0} ball</li>\`;
                    });
                    window.currentAdminKey = key;
                }

                async function resetData() {
                    if (!confirm('Haqiqatan ham barcha natijalarni o\\'chirib tashlamoqchimisiz?')) return;
                    const res = await fetch('/api/results', {
                        method: 'DELETE',
                        headers: { 'x-admin-key': window.currentAdminKey }
                    });
                    if (res.status === 200) {
                        alert('Reyting muvaffaqiyatli tozalandi!');
                        location.reload();
                    } else {
                        alert('Xatolik yuz berdi!');
                    }
                }
            </script>
        </body>
        </html>
        `);
        return;
    }

    // --- API QISMI ---
    if (pathname === '/api/results') {
        if (req.method === 'GET') {
            return send(res, 200, rows.map(({ cid, ...r }) => ({ id: cid, ...r })));
        }
        if (req.method === 'DELETE') {
            if (req.headers['x-admin-key']!== ADMIN_KEY) return send(res, 403, { error: 'Unauthorized' });
            rows = [];
            save();
            return send(res, 200, { success: true });
        }
        if (req.method === 'POST') {
            let b = '';
            req.on('data', d => { b += d; if (b.length > 5000) req.destroy(); });
            req.on('end', () => {
                try {
                    const j = JSON.parse(b);
                    const name = String(j.name || '').trim().slice(0, 40), cid = String(j.cid || '').slice(0, 60);
                    const t = Math.min(NQ, Math.max(0, j.test | 0)), w = Math.min(NW, Math.max(0, j.cw | 0)), sec = Math.min(36000, Math.max(0, j.sec | 0));
                    if (name.length < 3 || !cid) return send(res, 400, { error: 'Invalid data' });
                    if (rows.some(r => r.cid === cid)) return send(res, 409, { error: 'already' });
                    const base = t * T_PTS + w * W_PTS, total = Math.round((base + 10 * (base / BASE) * Math.max(0, 1 - sec / MAXT)) * 100) / 100;
                    rows.push({ cid, name, test: t, cw: w, base, sec, total, ts: Date.now() });
                    save();
                    send(res, 200, { total });
                } catch (e) { send(res, 400, { error: 'Bad request' }); }
            });
            return;
        }
        return send(res, 405, { error: 'Method not allowed' });
    }

    // --- ASOSIY SAHIFA (TO'G'RILANGAN YO'L) ---
    let filePath = path.join(__dirname, pathname === '/' ? 'index.html' : pathname);
    fs.readFile(filePath, (e, d) => {
        if (e) {
            fs.readFile(path.join(__dirname, 'index.html'), (err, fallbackData) => {
                if (err) { res.writeHead(404); res.end('Not Found'); return; }
                res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
                res.end(fallbackData);
            });
            return;
        }
        const ext = path.extname(filePath);
        let contentType = 'text/html';
        if (ext === '.js') contentType = 'application/javascript';
        else if (ext === '.css') contentType = 'text/css';
        else if (ext === '.json') contentType = 'application/json';
        else if (ext === '.png') contentType = 'image/png';
        else if (ext === '.jpg') contentType = 'image/jpeg';

        res.writeHead(200, { 'Content-Type': contentType + '; charset=utf-8' });
        res.end(d);
    });
}).listen(PORT, () => console.log('Sayt ishga tushdi: http://localhost:' + PORT));
